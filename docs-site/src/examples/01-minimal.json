{
  "providers": [
    {
      "type": "remote",
      "tag": "my-subscription",
      "url": "https://example.com/subscription",
      "update_interval": "12h"
    }
  ],
  "outbounds": [
    {
      "type": "smart",
      "tag": "auto",
      "providers": ["my-subscription"]
    },
    { "type": "direct", "tag": "direct" }
  ],
  "route": {
    "final": "auto"
  },
  "experimental": {
    "cache_file": { "enabled": true },
    "clash_api": { "external_controller": "127.0.0.1:9090" }
  }
}
