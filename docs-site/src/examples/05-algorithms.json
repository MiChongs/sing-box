{
  "outbounds": [
    {
      "type": "smart",
      "tag": "smart-interactive",
      "providers": ["my-subscription"],
      "algorithm": "latency-banded",
      "hysteresis": "1m"
    },
    {
      "type": "smart",
      "tag": "smart-bulk",
      "providers": ["my-subscription"],
      "algorithm": "least-loaded",
      "disable_udp": true
    },
    {
      "type": "smart",
      "tag": "smart-sticky",
      "providers": ["my-subscription"],
      "algorithm": "sticky-session"
    },
    {
      "type": "smart",
      "tag": "smart-default",
      "providers": ["my-subscription"],
      "algorithm": "p2c"
    }
  ],
  "route": {
    "rules": [
      { "port": [22, 3389], "outbound": "smart-interactive" },
      { "domain_suffix": ["steamcontent.com", "githubusercontent.com"], "outbound": "smart-bulk" },
      { "domain_suffix": ["openai.com", "claude.ai"], "outbound": "smart-sticky" }
    ],
    "final": "smart-default"
  }
}
