{
  "outbounds": [
    {
      "type": "smart",
      "tag": "auto",
      "providers": ["my-subscription"],
      "exclude": "(?i)剩余|到期|官网|expire",
      "url": "https://www.gstatic.com/generate_204",
      "expected_status": "204",
      "interval": "5m",
      "idle_timeout": "30m",
      "timeout": "5s",
      "tolerance": 50,
      "max_failed_times": 5,
      "policy_priority": "香港|HK:1.2;日本|JP:1.1;(?i)x[2-9]:0.7",
      "interrupt_exist_connections": true
    }
  ]
}
