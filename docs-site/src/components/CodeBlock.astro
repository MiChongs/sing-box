---
import { codeToHtml } from 'shiki';
import { ui } from '../i18n/ui';
import type { Lang } from '../data/nav';

// Build-time highlighted block with a file-name header and copy button.
// Used for whole example files; inline Markdown fences get a lighter
// frame from DocsLayout instead.

export interface Props {
  code: string;
  lang?: string;
  filename?: string;
  locale: Lang;
}

const { code, lang = 'json', filename, locale } = Astro.props;
const t = ui[locale];
const html = await codeToHtml(code.trimEnd(), {
  lang,
  themes: { light: 'github-light', dark: 'github-dark' },
});
---

<figure class="not-prose my-6 overflow-hidden rounded-card bg-surface shadow-ring">
  <figcaption class="flex items-center gap-3 border-b border-line-soft bg-surface-2/50 px-4 py-2">
    <span class="rounded bg-surface px-1.5 py-0.5 font-mono text-[0.68rem] font-medium uppercase tracking-wider text-muted shadow-ring">{lang}</span>
    <span class="min-w-0 flex-1 truncate font-mono text-[0.82rem] text-muted">{filename}</span>
    <button
      type="button"
      data-copy-block
      data-label={t.copy}
      data-done={t.copied}
      data-fail={t.copyFailed}
      class="rounded-md px-2 py-1 text-[0.78rem] text-muted hover:bg-surface hover:text-fg"
    >
      {t.copy}
    </button>
  </figcaption>
  <div class="scroll-thin max-h-[36rem] overflow-auto" data-code-src>
    <Fragment set:html={html} />
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-block]').forEach((btn) => {
    if (btn.dataset.wired) return;
    btn.dataset.wired = '1';
    btn.addEventListener('click', async () => {
      const src = btn.closest('figure')?.querySelector<HTMLElement>('[data-code-src]');
      try {
        await navigator.clipboard.writeText(src?.innerText ?? '');
        btn.textContent = btn.dataset.done ?? 'Copied';
      } catch {
        btn.textContent = btn.dataset.fail ?? 'Failed';
      }
      setTimeout(() => (btn.textContent = btn.dataset.label ?? 'Copy'), 1400);
    });
  });
</script>
