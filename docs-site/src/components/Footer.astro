---
import { ui } from '../i18n/ui';
import type { Lang } from '../data/nav';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<footer class="mt-20 border-t border-line-soft">
  <div class="mx-auto flex max-w-page flex-col gap-4 px-4 py-8 text-[0.88rem] sm:px-6 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="font-display text-[1rem] font-semibold tracking-tight text-fg">{t.siteName}</p>
      <p class="mt-1 text-subtle">{t.footerNote}</p>
    </div>
    <div class="flex flex-wrap gap-x-5 gap-y-2 text-muted">
      <a class="text-muted hover:text-fg" href="https://github.com/MiChongs/sing-box" target="_blank" rel="noopener">GitHub</a>
      <a class="text-muted hover:text-fg" href="https://github.com/MiChongs/sing-box/releases" target="_blank" rel="noopener">Releases</a>
      <a class="text-muted hover:text-fg" href="https://github.com/reF1nd/sing-box" target="_blank" rel="noopener">reF1nd/sing-box</a>
      <a class="text-muted hover:text-fg" href="https://sing-box.sagernet.org/" target="_blank" rel="noopener">sing-box</a>
    </div>
  </div>
</footer>
