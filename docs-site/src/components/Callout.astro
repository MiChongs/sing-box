---
export interface Props {
  type?: 'note' | 'tip' | 'warn' | 'danger';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const tone = {
  note: { box: 'bg-info-soft/60 border-info', title: 'text-info' },
  tip: { box: 'bg-ok-soft/60 border-ok', title: 'text-ok' },
  warn: { box: 'bg-accent-soft/70 border-accent', title: 'text-accent' },
  danger: { box: 'bg-danger-soft/70 border-danger', title: 'text-danger' },
}[type];
---

<aside class={`not-prose my-6 rounded-r-card border-l-[3px] px-4 py-3 text-[0.95rem] leading-relaxed text-fg-2 ${tone.box}`}>
  {title && <p class={`mb-1 font-semibold ${tone.title}`}>{title}</p>}
  <div class="callout-body [&>*:first-child]:mt-0 [&>*:last-child]:mb-0 [&_p]:my-2">
    <slot />
  </div>
</aside>
