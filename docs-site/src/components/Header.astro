---
import { ui, href } from '../i18n/ui';
import type { Lang } from '../data/nav';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const path = Astro.url.pathname;

const links = [
  { label: t.nav.docs, slug: 'quick-start', match: ['quick-start', 'how-it-works', 'algorithms', 'smart-loadbalance', 'priority-and-pinning', 'health', 'lightgbm', 'asn-geox', 'storage-performance', 'troubleshooting', 'changelog'] },
  { label: t.nav.config, slug: 'config', match: ['config'] },
  { label: t.nav.api, slug: 'clash-api', match: ['clash-api'] },
  { label: t.nav.examples, slug: 'examples', match: ['examples'] },
];
const isActive = (match: string[]) => match.some((m) => path.includes(`/${lang}/${m}/`));

// Same page in the other locale: swap the locale segment only.
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const otherPath = path.replace(new RegExp(`/${lang}(/|$)`), `/${other}$1`);
---

<header class="sticky top-0 z-30 border-b border-line-soft bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex h-14 max-w-page items-center gap-3 px-4 sm:px-6">
    <button
      type="button"
      data-drawer-open
      class="-ml-1 inline-flex h-9 w-9 items-center justify-center rounded-md text-muted hover:bg-surface-2 hover:text-fg lg:hidden"
      aria-label={t.menu}
      aria-expanded="false"
      aria-controls="drawer"
    >
      <svg viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" /></svg>
    </button>

    <a href={href(lang)} class="flex items-center gap-2 text-fg hover:text-fg">
      <img src={`${import.meta.env.BASE_URL}favicon.svg`} alt="" class="h-6 w-6" width="24" height="24" />
      <span class="font-serif text-[1.15rem] leading-none">{t.siteName}</span>
    </a>

    <nav class="ml-6 hidden items-center gap-1 lg:flex" aria-label="Primary">
      {links.map((l) => (
        <a
          href={href(lang, l.slug)}
          class:list={[
            'rounded-md px-3 py-1.5 text-[0.92rem] transition-colors',
            isActive(l.match) ? 'bg-surface-2 text-fg' : 'text-muted hover:text-fg',
          ]}
          aria-current={isActive(l.match) ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-1">
      <a
        href={otherPath}
        hreflang={other === 'zh' ? 'zh-CN' : 'en'}
        class="inline-flex h-9 min-w-9 items-center justify-center rounded-md px-2 text-[0.9rem] text-muted hover:bg-surface-2 hover:text-fg"
        aria-label={t.switchLang}
        title={t.switchLang}
      >
        {t.langShort}
      </a>
      <button
        type="button"
        data-theme-toggle
        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-muted hover:bg-surface-2 hover:text-fg"
        aria-label={t.themeToggle}
        title={t.themeToggle}
      >
        <svg viewBox="0 0 20 20" class="h-[18px] w-[18px] dark:hidden" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16.5 12.2A7 7 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7Z" /></svg>
        <svg viewBox="0 0 20 20" class="hidden h-[18px] w-[18px] dark:block" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="3.4" /><path d="M10 1.8v2M10 16.2v2M1.8 10h2M16.2 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4" /></svg>
      </button>
      <a
        href="https://github.com/MiChongs/sing-box"
        target="_blank"
        rel="noopener"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md text-muted hover:bg-surface-2 hover:text-fg"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg viewBox="0 0 16 16" class="h-[18px] w-[18px]" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
      </a>
    </div>
  </div>
</header>
