---
import type { Field } from '../data/fields';
import type { Lang } from '../data/nav';
import { inline } from '../lib/inline';

// Config reference rendered as a definition list rather than a table:
// descriptions are long, and a 4-column table collapses badly on phones.
// Each field gets a stable anchor: #<prefix><name>.

export interface Props {
  lang: Lang;
  fields: Field[];
  prefix?: string;
}

const { lang, fields, prefix = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const labels = lang === 'zh'
  ? { def: '默认', required: '必填', none: '无' }
  : { def: 'default', required: 'required', none: 'none' };
const anchor = (name: string) => `${prefix}${name}`.replace(/[^a-zA-Z0-9_-]+/g, '-');
---

<dl class="not-prose my-6 divide-y divide-line-soft overflow-hidden rounded-card bg-surface shadow-ring">
  {fields.map((f) => (
    <div id={anchor(f.name)} class="scroll-mt-20 px-4 py-4 sm:px-5">
      <dt class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <a href={`#${anchor(f.name)}`} class="font-mono text-[0.92rem] font-semibold text-accent hover:underline">{f.name}</a>
        <span class="rounded bg-surface-2 px-1.5 py-0.5 font-mono text-[0.74rem] text-muted">{f.type}</span>
        {f.required && (
          <span class="rounded bg-danger-soft px-1.5 py-0.5 text-[0.72rem] font-medium text-danger">{labels.required}</span>
        )}
        {f.default !== undefined && (
          <span class="text-[0.8rem] text-subtle">
            {labels.def} <code class="rounded bg-surface-2 px-1.5 py-0.5 font-mono text-[0.76rem] text-fg-2">{f.default}</code>
          </span>
        )}
      </dt>
      <dd class="mt-2 text-[0.93rem] leading-relaxed text-fg-2 [&_p+p]:mt-2" set:html={f[lang].split('\n\n').map((p) => `<p>${inline(p, base)}</p>`).join('')} />
    </div>
  ))}
</dl>
