---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import PrevNext from '../components/PrevNext.astro';
import { ui } from '../i18n/ui';
import type { Lang } from '../data/nav';

export interface Props {
  lang: Lang;
  slug: string;
  title: string;
  description: string;
  headings: MarkdownHeading[];
}

const { lang, slug, title, description, headings } = Astro.props;
const t = ui[lang];
const editUrl = `https://github.com/MiChongs/sing-box/edit/xiaobaf14g-testing/docs-site/src/content/docs/${lang}/${slug}.mdx`;
---

<BaseLayout lang={lang} title={title} description={description} current={slug}>
  <div class="mx-auto flex max-w-page gap-10 px-4 sm:px-6">
    <aside class="hidden w-56 shrink-0 lg:block">
      <div class="sticky top-14 max-h-[calc(100vh-3.5rem)] overflow-y-auto scroll-thin py-8 pr-2">
        <Sidebar lang={lang} current={slug} />
      </div>
    </aside>

    <article class="min-w-0 flex-1 py-8 lg:py-10">
      <header class="mb-8 max-w-prose">
        <h1 class="text-[2rem] leading-tight sm:text-[2.4rem]">{title}</h1>
        <p class="mt-3 text-[1.08rem] leading-relaxed text-muted">{description}</p>
      </header>
      <div class="prose-doc max-w-prose" data-doc-body>
        <slot />
      </div>
      <div class="max-w-prose">
        <p class="mt-12 text-[0.85rem]">
          <a href={editUrl} target="_blank" rel="noopener" class="text-subtle hover:text-accent">{t.editPage}</a>
        </p>
        <PrevNext lang={lang} slug={slug} />
      </div>
    </article>

    <aside class="hidden w-52 shrink-0 xl:block">
      <div class="sticky top-14 max-h-[calc(100vh-3.5rem)] overflow-y-auto scroll-thin py-10">
        <Toc headings={headings} label={t.onThisPage} />
      </div>
    </aside>
  </div>

  <script define:vars={{ copy: t.copy, copied: t.copied, failed: t.copyFailed }}>
    // Give every rendered code fence a copy button.
    document.querySelectorAll('[data-doc-body] pre.astro-code').forEach((pre) => {
      if (pre.closest('figure') || pre.parentElement?.classList.contains('code-frame')) return;
      const frame = document.createElement('div');
      frame.className = 'code-frame';
      pre.replaceWith(frame);
      frame.appendChild(pre);
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy-fab rounded-md bg-surface-2 px-2 py-1 text-[0.75rem] text-muted shadow-ring hover:text-fg';
      btn.textContent = copy;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.innerText);
          btn.textContent = copied;
        } catch (e) {
          btn.textContent = failed;
        }
        setTimeout(() => (btn.textContent = copy), 1400);
      });
      frame.appendChild(btn);
    });
  </script>
</BaseLayout>
