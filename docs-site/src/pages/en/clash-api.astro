---
import DocLayout from '../../layouts/DocLayout.astro';
import EndpointRow from '../../components/EndpointRow.astro';
import Callout from '../../components/Callout.astro';
import { endpoints, groupLabels, type Group } from '../../data/clash-endpoints';

const ORDER: Group[] = ['inspect', 'control', 'flush'];
---

<DocLayout lang="en" title="Clash API">
  <article class="py-16 max-w-prose lg:max-w-none">
    <h1 class="font-serif text-section-52 mb-4">Clash API</h1>
    <p class="font-sans text-lead-20 text-olive-gray mb-8 max-w-prose">
      Smart layers 13 endpoints on top of the regular Clash API, split across <code class="font-mono">/smart/*</code>,
      <code class="font-mono">/proxies/{'{name}'}/*</code>, and <code class="font-mono">/cache/smart/*</code>. All curl samples assume
      <code class="font-mono">external_controller: "127.0.0.1:9090"</code>; add <code>Authorization: Bearer &lt;secret&gt;</code> when configured.
    </p>

    <Callout type="note" title="Port & auth">
      <p>
        Port and bearer secret come from <code class="font-mono">experimental.clash_api.external_controller</code>
        and <code class="font-mono">secret</code>. All endpoints share the standard Clash API CORS / auth middleware.
      </p>
    </Callout>

    {ORDER.map((g) => (
      <section class="mt-12">
        <h2 class="font-serif text-card-32 mb-4">{groupLabels.en[g]}</h2>
        {endpoints.filter(e => e.group === g).map((ep) => (
          <EndpointRow lang="en" ep={ep} />
        ))}
      </section>
    ))}
  </article>
</DocLayout>
